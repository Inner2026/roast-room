# Never commit a real .env. On the host, set these as environment variables.
ANTHROPIC_API_KEY=          # from console.anthropic.com (pay-per-use; separate from Claude Pro)
ALLOWED_EMAILS=you@example.com   # comma list; only these can register. Empty = anyone can.
REGISTRATION=open           # "closed" to stop all new sign-ups
GLOBAL_DAILY_BUDGET_USD=10  # service stops starting runs after this much estimated spend per 24h
GLOBAL_DAILY_RUN_CAP=100
MAX_CONCURRENT_RUNS=3
# MODEL_SEATS=claude-sonnet-5-5
# LLM_PROVIDER=mock         # run without spending anything (placeholder answers)
